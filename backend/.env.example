# ==============================================================================
# MOUTII E-COMMERCE — VARIABLES DE ENTORNO DEL BACKEND
# ==============================================================================

# Puerto en el que corre el servidor backend (NestJS)
PORT=3000

# Cadena de conexión a MongoDB
# Local (desarrollo):
MONGODB_URI=mongodb://localhost:27017/mouti
# Producción (ejemplo con MongoDB Atlas):
# MONGODB_URI=mongodb+srv://<usuario>:<password>@cluster0.abcde.mongodb.net/mouti?retryWrites=true&w=majority

# Clave secreta para firmar los tokens JWT de autenticación (Cámbiala en producción por una clave larga y segura)
JWT_SECRET=mouti_boutique_secret_key_2026_daniela_mejia

# Origen permitido para CORS (opcional, en producción define tu dominio frontend)
# FRONTEND_URL=https://mouti.com

# Cloudinary — Alojamiento persistente en la nube para imágenes (esencial para Render)
# Puedes usar las credenciales individuales:
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# O la URL completa que provee el dashboard de Cloudinary:
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
